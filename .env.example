# Copy this file to .env and fill in your real values.

# Required for real OpenRouter model calls.
# Get your key at https://openrouter.ai/
OPENROUTER_API_KEY=sk-or-v1-...

# Set to true to simulate model responses (no API calls). Useful for testing
# UI changes like loaders, tabs, rankings, and the SSE stream without
# spending credits. No OPENROUTER_API_KEY is needed when this is enabled.
USE_SIMULATED_MODELS=false

# Per-call delay for simulated model responses, in seconds. Increase this to
# make stages take longer and exercise loaders / heartbeat UI.
SIMULATED_MODEL_DELAY_S=0.5
